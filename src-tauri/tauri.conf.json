{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkD. MD Viewer",
  "version": "0.1.0",
  "identifier": "com.arkd.mdviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkD. MD Viewer",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#FAF8F4",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Fast, lightweight markdown viewer",
    "longDescription": "ArkD. MD Viewer is a fast, lightweight markdown viewer with an on-demand editing mode.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
