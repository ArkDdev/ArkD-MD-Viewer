{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkD. MD Viewer",
  "mainBinaryName": "ArkD-MD-Viewer",
  "version": "1.3.1",
  "identifier": "com.arkd.mdviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkD. MD Viewer",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "backgroundColor": "#FAF8F4",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ArkD.DEV",
    "homepage": "https://github.com/ArkDdev/ArkD-MD-Viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Fast, lightweight markdown viewer",
    "longDescription": "ArkD. MD Viewer is a fast, lightweight markdown viewer with an on-demand editing mode.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["json", "json5"],
        "name": "JSON Document",
        "description": "JSON data file",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML Document",
        "description": "YAML configuration file",
        "mimeType": "application/x-yaml",
        "role": "Editor"
      },
      {
        "ext": ["toml"],
        "name": "TOML Document",
        "description": "TOML configuration file",
        "mimeType": "application/toml",
        "role": "Editor"
      },
      {
        "ext": ["ini", "conf"],
        "name": "INI Configuration",
        "description": "INI / config file",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "XML Document",
        "description": "XML data file",
        "mimeType": "application/xml",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "Comma-separated values file",
        "mimeType": "text/csv",
        "role": "Editor"
      },
      {
        "ext": ["tsv"],
        "name": "TSV Document",
        "description": "Tab-separated values file",
        "mimeType": "text/tab-separated-values",
        "role": "Editor"
      },
      {
        "ext": ["log"],
        "name": "Log File",
        "description": "Application log file",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Document",
        "description": "Plain text file",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["en-US", "ru-RU"]
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
