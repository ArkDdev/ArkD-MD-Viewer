{
  "name": "arkd-md-viewer",
  "private": true,
  "version": "1.1.8",
  "description": "ArkD. MD Viewer — fast, lightweight markdown viewer with editing mode",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
